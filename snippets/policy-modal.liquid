<div id="kosnora-policy-modal" class="kosnora-modal-backdrop" aria-hidden="true">
  <div class="kosnora-modal" role="dialog" aria-modal="true">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.25rem;">
      <h3 id="policy-modal-title" style="font-size: 1.125rem; font-weight: 700; color: #FFF;">
        Policy Notice
      </h3>
      <button type="button" data-close-modal style="background: none; border: none; color: #9CA3AF; cursor: pointer; padding: 4px;">
        {% render 'icon-close' %}
      </button>
    </div>

    <div style="font-size: 12px; font-weight: 600; color: #FCD34D; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25); padding: 8px 12px; border-radius: 8px; margin-bottom: 1rem;">
      [Notice: This document is ready for real operational terms.]
    </div>

    <div id="policy-modal-body" style="font-size: 0.875rem; color: #D1D5DB; line-height: 1.6; max-height: 50vh; overflow-y: auto; white-space: pre-line; margin-bottom: 1.5rem;">
      Loading policy content...
    </div>

    <div style="display: flex; justify-content: flex-end;">
      <button type="button" data-close-modal style="padding: 0.6rem 1.25rem; background: #26272E; color: #FFF; border-radius: 0.5rem; font-size: 0.8125rem; font-weight: 600; border: none; cursor: pointer;">
        Close Window
      </button>
    </div>
  </div>
</div>
