<section class="section-light kosnora-py" style="border-top: 1px solid #E5E7EB;">
  <div class="kosnora-container">
    <!-- Header -->
    <div style="max-width: 760px; margin: 0 auto; text-align: center; margin-bottom: 4rem;">
      <span class="kosnora-kicker-badge light">
        {{ section.settings.kicker | default: 'The Everyday Monotony' }}
      </span>
      <h2 class="kosnora-headline" style="font-size: clamp(2rem, 4vw, 3rem); color: #111827; margin-bottom: 1.25rem;">
        {{ section.settings.headline | default: 'Why Use The Same Phone Case Every Day?' }}
      </h2>
      <p class="kosnora-subtitle" style="font-size: 1.125rem; color: #4B5563;">
        {{ section.settings.description | default: 'Your smartphone is the most personal object you carry everywhere you go. Yet for years, phone cases have locked you into one static look.' }}
      </p>
    </div>

    <!-- 5 Situations Grid -->
    <div class="kosnora-grid-3" style="margin-bottom: 4rem;">
      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1.125rem; color: #111827; margin-bottom: 0.75rem;">
          Wallpaper Isn't Enough
        </h3>
        <p style="font-size: 0.875rem; color: #4B5563; line-height: 1.6;">
          You love a photo, but your home screen is cluttered with app icons and lock screen widgets.
        </p>
      </div>

      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1.125rem; color: #111827; margin-bottom: 0.75rem;">
          Your Style Changes Constantly
        </h3>
        <p style="font-size: 0.875rem; color: #4B5563; line-height: 1.6;">
          Your outfit, mood, and aesthetic shift daily — yet your phone case stays glued to the same look for months.
        </p>
      </div>

      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1.125rem; color: #111827; margin-bottom: 0.75rem;">
          Bored of Buying New Cases
        </h3>
        <p style="font-size: 0.875rem; color: #4B5563; line-height: 1.6;">
          Buying multiple physical cases is wasteful, expensive, and leaves you with drawers full of discarded plastic.
        </p>
      </div>

      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1.125rem; color: #111827; margin-bottom: 0.75rem;">
          A Phone That Feels Impersonal
        </h3>
        <p style="font-size: 0.875rem; color: #4B5563; line-height: 1.6;">
          Everyone carries the exact same mass-produced smartphone. It rarely feels like an authentic reflection of who you are.
        </p>
      </div>

      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1.125rem; color: #111827; margin-bottom: 0.75rem;">
          Want Something People Haven't Seen
        </h3>
        <p style="font-size: 0.875rem; color: #4B5563; line-height: 1.6;">
          Standard cases are boring. You want an accessory that sparks curiosity and conversations the moment you set it down.
        </p>
      </div>

      <div class="kosnora-card-dark">
        <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #9CA3AF; display: block; margin-bottom: 0.5rem;">
          The Solution
        </span>
        <h3 class="kosnora-title" style="font-size: 1.25rem; color: #FFF; margin-bottom: 0.75rem;">
          One Device. Infinite Looks.
        </h3>
        <p style="font-size: 0.875rem; color: #D1D5DB; line-height: 1.6;">
          Personalize your phone anytime without having to buy or swap physical cases.
        </p>
      </div>
    </div>

    <!-- Transformation Comparison Block -->
    <div style="max-width: 900px; margin: 0 auto; background: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 1.5rem; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
        <!-- Traditional Case -->
        <div style="padding: 2.5rem; background: #F9FAFB; border-right: 1px solid #E5E7EB;">
          <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #6B7280; letter-spacing: 0.05em; display: block; margin-bottom: 0.75rem;">
            Traditional phone case:
          </span>
          <h4 class="kosnora-title" style="font-size: 1.5rem; color: #111827; margin-bottom: 0.75rem;">
            Same look every day.
          </h4>
          <p style="font-size: 0.875rem; color: #4B5563; line-height: 1.6;">
            Stuck with one static print or plain color for months. You either live with boredom or keep spending money on replacement cases that clutter your home.
          </p>
        </div>

        <!-- KOSNORA Smart Case -->
        <div style="padding: 2.5rem; background: #0A0A0C; color: #FFFFFF;">
          <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #34D399; letter-spacing: 0.05em; display: block; margin-bottom: 0.75rem;">
            KOSNORA:
          </span>
          <h4 class="kosnora-title" style="font-size: 1.5rem; color: #FFFFFF; margin-bottom: 0.75rem;">
            A different look whenever you want.
          </h4>
          <p style="font-size: 0.875rem; color: #D1D5DB; line-height: 1.6;">
            Switch between your partner, pet, weekend vacation snapshot, or clean architectural artwork in just 5 minutes. No battery, no hassle, endless versatility.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Problem Section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The Everyday Monotony"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Why Use The Same Phone Case Every Day?"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Your smartphone is the most personal object you carry everywhere you go. Yet for years, phone cases have locked you into one static look."
    }
  ],
  "presets": [
    {
      "name": "Problem Section"
    }
  ]
}
{% endschema %}
