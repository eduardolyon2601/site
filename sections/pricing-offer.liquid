<section id="pricing" class="section-dark" style="background: #000; padding: 4.5rem 0; border-bottom: 1px solid #1E2026; color: #FFF;">
  <div class="kosnora-container">
    <!-- Header -->
    <div style="max-width: 650px; margin: 0 auto; text-align: center; margin-bottom: 3.5rem;">
      <span style="font-size: 11px; font-weight: 900; letter-spacing: 0.15em; text-transform: uppercase; color: #C084FC; display: block; margin-bottom: 0.5rem;">
        SIMPLE BUNDLES
      </span>
      <h2 style="font-size: clamp(2rem, 4.5vw, 3.25rem); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; margin-bottom: 0.75rem;">
        {{ section.settings.headline | default: 'CHOOSE YOUR KOSNORA' }}
      </h2>
      <p style="font-size: 1rem; color: #A1A1AA; font-weight: 600; margin: 0;">
        {{ section.settings.description | default: 'Select your bundle and iPhone model. Battery-free NFC smart case included.' }}
      </p>
    </div>

    <!-- 3 Simple Pricing Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; max-width: 1050px; margin: 0 auto;">
      <!-- 1 Case -->
      <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <h3 style="font-size: 1.25rem; font-weight: 900; text-transform: uppercase; margin-bottom: 1rem;">1 CASE</h3>
          <div style="font-size: 2.75rem; font-weight: 900; color: #FFF; line-height: 1; margin-bottom: 1.25rem;">
            $79.90
          </div>
          <ul style="list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.8125rem; color: #D4D4D8; font-weight: 600;">
            <li style="display: flex; align-items: center; gap: 0.5rem;"><span style="color: #C084FC;">✓</span> 1x KOSNORA Smart Phone Case</li>
            <li style="display: flex; align-items: center; gap: 0.5rem;"><span style="color: #C084FC;">✓</span> Battery-free passive NFC display</li>
            <li style="display: flex; align-items: center; gap: 0.5rem;"><span style="color: #C084FC;">✓</span> Shock-absorbing protective frame</li>
          </ul>
        </div>
        <button type="button" data-open-drawer data-qty="1" class="kosnora-btn-secondary" style="width: 100%; padding: 1rem; font-size: 0.8125rem; background: #FFF; color: #000; font-weight: 900; text-transform: uppercase; border-radius: 12px; cursor: pointer; border: none;">
          GET MY KOSNORA
        </button>
      </div>

      <!-- 2 Cases -->
      <div style="background: #0A0A0E; border: 1px solid #3F3F46; border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between; position: relative;">
        <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #27272A; border: 1px solid #52525B; color: #C084FC; font-size: 10px; font-weight: 900; padding: 3px 12px; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap;">
          SAVE $20.00
        </div>
        <div>
          <h3 style="font-size: 1.25rem; font-weight: 900; text-transform: uppercase; margin-bottom: 1rem;">2 CASES</h3>
          <div style="margin-bottom: 1.25rem;">
            <div style="font-size: 2.75rem; font-weight: 900; color: #FFF; line-height: 1;">
              $69.90 <span style="font-size: 0.875rem; color: #A1A1AA; font-weight: 700;">EACH</span>
            </div>
            <div style="font-size: 0.75rem; font-weight: 800; color: #C084FC; margin-top: 4px;">
              $139.80 TOTAL
            </div>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.8125rem; color: #D4D4D8; font-weight: 600;">
            <li style="display: flex; align-items: center; gap: 0.5rem;"><span style="color: #C084FC;">✓</span> 2x KOSNORA Smart Phone Cases</li>
            <li style="display: flex; align-items: center; gap: 0.5rem;"><span style="color: #C084FC;">✓</span> Battery-free passive NFC display</li>
            <li style="display: flex; align-items: center; gap: 0.5rem;"><span style="color: #C084FC;">✓</span> Shock-absorbing protective frame</li>
          </ul>
        </div>
        <button type="button" data-open-drawer data-qty="2" class="kosnora-btn-secondary" style="width: 100%; padding: 1rem; font-size: 0.8125rem; background: #FFF; color: #000; font-weight: 900; text-transform: uppercase; border-radius: 12px; cursor: pointer; border: none;">
          GET MY KOSNORA
        </button>
      </div>

      <!-- 3 Cases (Best Value) -->
      <div style="background: #0A0A0E; border: 2px solid #A855F7; border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between; position: relative; box-shadow: 0 0 30px rgba(168, 85, 247, 0.25);">
        <div style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #9333EA 0%, #7E22CE 100%); color: #FFF; font-size: 10px; font-weight: 900; padding: 4px 14px; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap; box-shadow: 0 0 10px rgba(168,85,247,0.5);">
          SAVE $60.00 · BEST VALUE
        </div>
        <div>
          <h3 style="font-size: 1.25rem; font-weight: 900; text-transform: uppercase; margin-bottom: 1rem;">3 CASES</h3>
          <div style="margin-bottom: 1.25rem;">
            <div style="font-size: 2.75rem; font-weight: 900; color: #FFF; line-height: 1;">
              $59.90 <span style="font-size: 0.875rem; color: #A1A1AA; font-weight: 700;">EACH</span>
            </div>
            <div style="font-size: 0.75rem; font-weight: 800; color: #C084FC; margin-top: 4px;">
              $179.70 TOTAL
            </div>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.8125rem; color: #D4D4D8; font-weight: 600;">
            <li style="display: flex; align-items: center; gap: 0.5rem;"><span style="color: #C084FC;">✓</span> 3x KOSNORA Smart Phone Cases</li>
            <li style="display: flex; align-items: center; gap: 0.5rem;"><span style="color: #C084FC;">✓</span> Battery-free passive NFC display</li>
            <li style="display: flex; align-items: center; gap: 0.5rem;"><span style="color: #C084FC;">✓</span> Shock-absorbing protective frame</li>
          </ul>
        </div>
        <button type="button" data-open-drawer data-qty="3" class="kosnora-btn-primary" style="width: 100%; padding: 1rem; font-size: 0.8125rem; background: linear-gradient(135deg, #9333EA 0%, #A855F7 50%, #7E22CE 100%); color: #FFF; font-weight: 900; text-transform: uppercase; border-radius: 12px; cursor: pointer; border: none; box-shadow: 0 0 20px rgba(168, 85, 247, 0.4);">
          GET MY KOSNORA
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Offer & Pricing",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "CHOOSE YOUR KOSNORA"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Select your bundle and iPhone model. Battery-free NFC smart case included."
    }
  ],
  "presets": [
    {
      "name": "Offer & Pricing"
    }
  ]
}
{% endschema %}
