<section class="section-dark kosnora-py" style="border-top: 1px solid #1E2026; position: relative; overflow: hidden; text-align: center;">
  <!-- Ambient Glow -->
  <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 600px; height: 600px; background: rgba(255, 255, 255, 0.03); border-radius: 50%; filter: blur(140px); pointer-events: none;"></div>

  <div class="kosnora-container" style="position: relative; z-index: 2; max-width: 900px;">
    <!-- Kicker -->
    <div class="kosnora-kicker-badge" style="margin-bottom: 1.5rem;">
      <span>The Smart Personalization Revolution</span>
    </div>

    <!-- Headline -->
    <h2 class="kosnora-headline" style="font-size: clamp(2.25rem, 6vw, 4.5rem); color: #FFF; margin-bottom: 1.5rem; line-height: 1.08;">
      {{ section.settings.headline | default: 'STOP USING THE SAME LOOK EVERY DAY.' }}
    </h2>

    <!-- Subheadline -->
    <p class="kosnora-subtitle" style="font-size: clamp(1.125rem, 2.5vw, 1.5rem); color: #E5E7EB; margin-bottom: 1rem; font-weight: 600;">
      {{ section.settings.subheadline | default: 'Make your phone as unique as you are.' }}
    </p>

    <!-- Promise -->
    <p style="font-size: 1rem; color: #9CA3AF; margin-bottom: 3rem;">
      {{ section.settings.promise | default: 'Change your picture whenever you want — in just 5 minutes.' }}
    </p>

    <!-- Product Image Card -->
    <div style="max-width: 580px; margin: 0 auto 3rem; background: #0A0A0C; border: 1px solid #22232A; border-radius: 1.5rem; padding: 1rem; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);">
      <div style="border-radius: 1rem; overflow: hidden; position: relative;">
        <img src="{{ 'kosnora_hero_case.jpg' | asset_url }}" alt="KOSNORA Smart Case" style="width: 100%; height: auto; display: block; object-fit: cover;">
        <div style="position: absolute; bottom: 0; inset-x: 0; background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 100%); padding: 1rem; display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; color: #D1D5DB;">
          <span>Four Precision Colors</span>
          <span>100% Battery-Free</span>
        </div>
      </div>
    </div>

    <!-- CTA & Emotional Urgency -->
    <div style="display: flex; flex-direction: column; align-items: center; gap: 1rem;">
      <button type="button" data-open-drawer data-qty="3" class="kosnora-btn-primary" style="padding: 1.25rem 3rem; font-size: 1rem;">
        <span>{{ section.settings.cta_text | default: 'GET MY KOSNORA CASE' }}</span>
        {% render 'icon-arrow-right' %}
      </button>

      <div style="font-size: 0.875rem; font-weight: 600; color: #D1D5DB;">
        Starting at $59.90 each when you buy 3.
      </div>

      <div style="font-size: 0.875rem; color: #9CA3AF; font-style: italic; margin-top: 0.5rem;">
        "Your phone doesn't have to look like everyone else's."
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Closing Section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "STOP USING THE SAME LOOK EVERY DAY."
    },
    {
      "type": "text",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Make your phone as unique as you are."
    },
    {
      "type": "text",
      "id": "promise",
      "label": "Promise",
      "default": "Change your picture whenever you want — in just 5 minutes."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "GET MY KOSNORA CASE"
    }
  ],
  "presets": [
    {
      "name": "Closing Section"
    }
  ]
}
{% endschema %}
