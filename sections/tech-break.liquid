<section id="tech" class="section-dark" style="background: #050508; padding: 5rem 0; border-bottom: 1px solid #1E2026; color: #FFF; position: relative; overflow: hidden;">
  <div class="kosnora-container">
    <div style="text-align: center; max-width: 800px; margin: 0 auto 4rem;">
      <span style="font-size: 11px; font-weight: 900; letter-spacing: 0.15em; text-transform: uppercase; color: #C084FC; display: inline-block; margin-bottom: 1rem; background: #0A0A0E; padding: 4px 14px; border-radius: 9999px; border: 1px solid #27272A;">
        ⚡ THE DISPLAY REVOLUTION
      </span>
      <h2 style="font-size: clamp(2.25rem, 5.5vw, 4rem); font-weight: 900; text-transform: uppercase; line-height: 1.05; margin: 0 0 1rem;">
        SAME PHONE.<br>
        <span style="color: #C084FC; text-shadow: 0 0 25px rgba(168, 85, 247, 0.4);">DIFFERENT ENERGY.</span>
      </h2>
      <p style="font-size: 1.125rem; color: #A1A1AA; font-weight: 600; margin: 0; line-height: 1.5;">
        Standard phone cases lock you into one single look forever. KOSNORA unlocks a permanent smart ink display on your back cover with zero battery draw.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; align-items: center;">
      <div style="border-radius: 20px; overflow: hidden; border: 1px solid #27272A; aspect-ratio: 4/3; background: #0A0A0E;">
        <img src="{{ 'kosnora_close_up.jpg' | asset_url }}" alt="KOSNORA Engineering" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
      </div>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 14px; padding: 1.25rem;">
          <h3 style="font-size: 1.1rem; font-weight: 900; text-transform: uppercase; margin: 0 0 0.5rem; color: #FFF;">
            ⚡ 100% Passive NFC Energy
          </h3>
          <p style="font-size: 0.8125rem; color: #A1A1AA; font-weight: 500; margin: 0; line-height: 1.5;">
            No internal batteries or cables. Pulls microscopic transmission energy during the 3-second refresh, then holds image with zero standby power.
          </p>
        </div>

        <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 14px; padding: 1.25rem;">
          <h3 style="font-size: 1.1rem; font-weight: 900; text-transform: uppercase; margin: 0 0 0.5rem; color: #FFF;">
            🛡️ Mil-Grade Impact Protection
          </h3>
          <p style="font-size: 0.8125rem; color: #A1A1AA; font-weight: 500; margin: 0; line-height: 1.5;">
            Built with shock-absorbing TPU armor, raised camera bezel guard, and reinforced bumper corners tested against everyday drops.
          </p>
        </div>

        <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 14px; padding: 1.25rem;">
          <h3 style="font-size: 1.1rem; font-weight: 900; text-transform: uppercase; margin: 0 0 0.5rem; color: #FFF;">
            📱 Seamless iPhone Integration
          </h3>
          <p style="font-size: 0.8125rem; color: #A1A1AA; font-weight: 500; margin: 0; line-height: 1.5;">
            Engineered for selected iPhone models from iPhone 12 through 17 Pro Max with precision tactile buttons and wireless charging support.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tech Visual Break",
  "settings": [],
  "presets": [
    {
      "name": "Tech Visual Break"
    }
  ]
}
{% endschema %}
