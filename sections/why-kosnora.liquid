<section id="why-kosnora" class="section-dark" style="background: #000; padding: 4.5rem 0; border-bottom: 1px solid #1E2026; color: #FFF; position: relative;">
  <div class="kosnora-container">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 3rem;">
      <span style="font-size: 11px; font-weight: 900; letter-spacing: 0.15em; text-transform: uppercase; color: #C084FC; display: block; margin-bottom: 0.5rem;">
        WHY KOSNORA
      </span>
      <h2 style="font-size: clamp(2rem, 4.5vw, 3.25rem); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; margin: 0;">
        {{ section.settings.headline | default: 'ONE CASE. ENDLESS LOOKS.' }}
      </h2>
    </div>

    <!-- 4 Key Benefits Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
      <!-- PERSONAL -->
      <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: #121318; border: 1px solid #3F3F46; display: flex; align-items: center; justify-content: center; color: #C084FC; margin-bottom: 1.25rem; font-size: 20px;">
          👤
        </div>
        <div>
          <h3 style="font-size: 1.15rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
            PERSONAL
          </h3>
          <p style="font-size: 0.875rem; color: #A1A1AA; font-weight: 600; margin: 0; line-height: 1.4;">
            Make your phone feel like yours.
          </p>
        </div>
      </div>

      <!-- CHANGEABLE -->
      <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: #121318; border: 1px solid #3F3F46; display: flex; align-items: center; justify-content: center; color: #C084FC; margin-bottom: 1.25rem; font-size: 20px;">
          🔄
        </div>
        <div>
          <h3 style="font-size: 1.15rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
            CHANGEABLE
          </h3>
          <p style="font-size: 0.875rem; color: #A1A1AA; font-weight: 600; margin: 0; line-height: 1.4;">
            Switch your image whenever you want.
          </p>
        </div>
      </div>

      <!-- BATTERY-FREE -->
      <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: #121318; border: 1px solid #3F3F46; display: flex; align-items: center; justify-content: center; color: #C084FC; margin-bottom: 1.25rem; font-size: 20px;">
          ⚡
        </div>
        <div>
          <h3 style="font-size: 1.15rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
            BATTERY-FREE
          </h3>
          <p style="font-size: 0.875rem; color: #A1A1AA; font-weight: 600; margin: 0; line-height: 1.4;">
            No charging required for the display concept.
          </p>
        </div>
      </div>

      <!-- DIFFERENT -->
      <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 16px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div style="width: 44px; height: 44px; border-radius: 12px; background: #121318; border: 1px solid #3F3F46; display: flex; align-items: center; justify-content: center; color: #C084FC; margin-bottom: 1.25rem; font-size: 20px;">
          ✨
        </div>
        <div>
          <h3 style="font-size: 1.15rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.5rem; letter-spacing: 0.05em;">
            DIFFERENT
          </h3>
          <p style="font-size: 0.875rem; color: #A1A1AA; font-weight: 600; margin: 0; line-height: 1.4;">
            Stand out from ordinary phone cases.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Kosnora",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "ONE CASE. ENDLESS LOOKS."
    }
  ],
  "presets": [
    {
      "name": "Why Kosnora"
    }
  ]
}
{% endschema %}
