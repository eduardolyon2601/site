<section class="section-dark kosnora-py" style="position: relative; overflow: hidden;">
  <!-- Ambient light -->
  <div style="position: absolute; top: 15%; left: 50%; transform: translate(-50%, -50%); width: 600px; height: 400px; background: rgba(255, 255, 255, 0.03); border-radius: 50%; filter: blur(120px); pointer-events: none;"></div>

  <div class="kosnora-container" style="position: relative; z-index: 2;">
    <!-- Top Text Center Area -->
    <div style="max-width: 800px; margin: 0 auto; text-align: center; margin-bottom: 3.5rem;">
      <div class="kosnora-kicker-badge">
        <span style="width: 8px; height: 8px; border-radius: 50%; background: #34D399; display: inline-block;"></span>
        <span>{{ section.settings.kicker | default: 'KOSNORA Ink NFC Smart Phone Case' }}</span>
      </div>

      <h1 class="kosnora-headline" style="font-size: clamp(2.25rem, 6vw, 4.5rem); margin-bottom: 1.5rem; color: #FFFFFF;">
        {{ section.settings.headline_1 | default: 'YOUR PHONE.' }}<br>
        {{ section.settings.headline_2 | default: 'YOUR PICTURE.' }}<br>
        <span style="color: #9CA3AF;">{{ section.settings.headline_3 | default: 'YOUR MOOD.' }}</span>
      </h1>

      <p class="kosnora-subtitle" style="font-size: clamp(1rem, 2vw, 1.25rem); color: #D1D5DB; max-width: 640px; margin: 0 auto 2rem; font-weight: 500;">
        {{ section.settings.subheadline | default: 'Change the picture on the back of your phone whenever you want — in just 5 minutes.' }}
      </p>

      <!-- 3 Quick Benefits -->
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; margin-bottom: 2.5rem; font-size: 0.875rem; color: #E5E7EB; font-weight: 500;">
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="width: 20px; height: 20px; border-radius: 50%; background: #18181B; border: 1px solid #3F3F46; display: flex; align-items: center; justify-content: center; color: #34D399;">
            {% render 'icon-check' %}
          </span>
          <span>Change your image anytime</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="width: 20px; height: 20px; border-radius: 50%; background: #18181B; border: 1px solid #3F3F46; display: flex; align-items: center; justify-content: center; color: #34D399;">
            {% render 'icon-check' %}
          </span>
          <span>Battery-free smart display</span>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          <span style="width: 20px; height: 20px; border-radius: 50%; background: #18181B; border: 1px solid #3F3F46; display: flex; align-items: center; justify-content: center; color: #34D399;">
            {% render 'icon-check' %}
          </span>
          <span>Make your phone uniquely yours</span>
        </div>
      </div>

      <!-- Main CTA Button -->
      <div style="display: flex; flex-direction: column; align-items: center; gap: 0.75rem;">
        <button type="button" data-open-drawer data-qty="2" class="kosnora-btn-primary">
          <span>{{ section.settings.cta_text | default: 'GET YOUR KOSNORA CASE' }}</span>
          {% render 'icon-arrow-right' %}
        </button>
        <span style="font-size: 0.75rem; color: #9CA3AF; font-weight: 500;">
          {{ section.settings.microcopy | default: 'Available for selected iPhone models' }}
        </span>
      </div>

      <!-- Compatible models indicator -->
      <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid #1E2026; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; font-size: 11px; font-weight: 600; color: #9CA3AF;">
        <span style="color: #E5E7EB; margin-right: 0.5rem;">Compatible with:</span>
        <span style="padding: 2px 8px; border-radius: 4px; background: #121318; border: 1px solid #26272E;">iPhone 17 Series</span>
        <span style="padding: 2px 8px; border-radius: 4px; background: #121318; border: 1px solid #26272E;">iPhone 16 Series</span>
        <span style="padding: 2px 8px; border-radius: 4px; background: #121318; border: 1px solid #26272E;">iPhone 15 Series</span>
        <span style="padding: 2px 8px; border-radius: 4px; background: #121318; border: 1px solid #26272E;">iPhone 14 Series</span>
        <span style="padding: 2px 8px; border-radius: 4px; background: #121318; border: 1px solid #26272E;">iPhone 12 Series</span>
      </div>
    </div>

    <!-- Live Interactive Case Simulator -->
    <div class="simulator-box" style="max-width: 1040px; margin: 0 auto;">
      <div class="kosnora-grid-2">
        <!-- Phone Case Mockup Display -->
        <div style="display: flex; flex-direction: column; align-items: center;">
          <div id="kosnora-mockup" class="phone-mockup">
            <div class="phone-inner">
              <!-- Camera Island -->
              <div class="camera-island">
                <div class="lens-circle"><div class="lens-core"></div></div>
                <div class="lens-circle"><div class="lens-core"></div></div>
                <div class="lens-circle"><div class="lens-core"></div></div>
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px;">
                  <span style="width: 10px; height: 10px; border-radius: 50%; background: #FEF3C7;"></span>
                  <span style="width: 8px; height: 8px; border-radius: 50%; background: #374151;"></span>
                </div>
              </div>

              <!-- E-ink screen display -->
              <div class="e-ink-screen">
                <img id="kosnora-screen-img" src="{{ 'kosnora_couple_look.jpg' | asset_url }}" alt="KOSNORA Smart Display Screen">
                <span class="screen-badge">NFC DISPLAY</span>
              </div>

              <!-- Brand deboss -->
              <div class="phone-brand-deboss">
                KOSNORA
              </div>
            </div>
          </div>

          <div style="margin-top: 1rem; font-size: 11px; font-weight: 600; color: #9CA3AF; display: flex; align-items: center; gap: 6px;">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: #34D399; display: inline-block;"></span>
            <span>Interactive Simulator · Instant Screen Refresh</span>
          </div>
        </div>

        <!-- Controls Column -->
        <div style="display: flex; flex-direction: column; justify-content: center;">
          <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #9CA3AF; margin-bottom: 0.5rem;">
            Live Customization Preview
          </div>
          <h3 class="kosnora-title" style="font-size: 1.75rem; color: #FFF; margin-bottom: 0.75rem;">
            One Case. Any Picture. Any Time.
          </h3>
          <p style="font-size: 0.875rem; color: #D1D5DB; margin-bottom: 1.5rem; line-height: 1.6;">
            Test how different moments look on the back of your phone. Switch between styles in seconds, or upload your own favorite photo right now.
          </p>

          <!-- 1. Color Selector -->
          <div style="margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid #22232A;">
            <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #9CA3AF; margin-bottom: 0.75rem;">
              1. Choose Case Finish: <span id="active-color-label" style="color: #FFF; text-transform: none; font-weight: 600;">Obsidian Black</span>
            </label>
            <div style="display: flex; gap: 0.75rem;">
              <button type="button" data-simulator-color data-hex="#161618" data-name="Obsidian Black" class="active-color" style="width: 36px; height: 36px; border-radius: 50%; background: #161618; border: 2px solid #555; cursor: pointer;"></button>
              <button type="button" data-simulator-color data-hex="#4A4C50" data-name="Titanium Gray" style="width: 36px; height: 36px; border-radius: 50%; background: #4A4C50; border: 2px solid #666; cursor: pointer;"></button>
              <button type="button" data-simulator-color data-hex="#EAEAEA" data-name="Cloud White" style="width: 36px; height: 36px; border-radius: 50%; background: #EAEAEA; border: 2px solid #AAA; cursor: pointer;"></button>
              <button type="button" data-simulator-color data-hex="#1C2433" data-name="Midnight Navy" style="width: 36px; height: 36px; border-radius: 50%; background: #1C2433; border: 2px solid #2563EB; cursor: pointer;"></button>
            </div>
          </div>

          <!-- 2. Display Look Selector -->
          <div style="margin-bottom: 1.5rem;">
            <label style="display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #9CA3AF; margin-bottom: 0.75rem;">
              2. Switch The Display Look:
            </label>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; margin-bottom: 0.75rem;">
              <button type="button" data-simulator-look data-src="{{ 'kosnora_couple_look.jpg' | asset_url }}" class="active-look" style="padding: 0.75rem; border-radius: 0.75rem; border: 1px solid #333; background: #14151B; color: #FFF; text-align: left; cursor: pointer; font-size: 0.75rem; font-weight: 700;">
                Couple Photo
              </button>
              <button type="button" data-simulator-look data-src="{{ 'kosnora_pet_look.jpg' | asset_url }}" style="padding: 0.75rem; border-radius: 0.75rem; border: 1px solid #333; background: #14151B; color: #FFF; text-align: left; cursor: pointer; font-size: 0.75rem; font-weight: 700;">
                Pet Memory
              </button>
              <button type="button" data-simulator-look data-src="{{ 'kosnora_travel_art.jpg' | asset_url }}" style="padding: 0.75rem; border-radius: 0.75rem; border: 1px solid #333; background: #14151B; color: #FFF; text-align: left; cursor: pointer; font-size: 0.75rem; font-weight: 700;">
                Travel Horizon
              </button>
              <button type="button" data-simulator-look data-src="{{ 'kosnora_hero_case.jpg' | asset_url }}" style="padding: 0.75rem; border-radius: 0.75rem; border: 1px solid #333; background: #14151B; color: #FFF; text-align: left; cursor: pointer; font-size: 0.75rem; font-weight: 700;">
                Minimalist Art
              </button>
            </div>

            <!-- Upload Custom File -->
            <input type="file" id="kosnora-upload-input" accept="image/*" style="display: none;">
            <button type="button" id="kosnora-upload-btn" style="width: 100%; padding: 0.75rem; border-radius: 0.75rem; border: 1px dashed #4B5563; background: rgba(255, 255, 255, 0.04); color: #D1D5DB; font-size: 0.75rem; font-weight: 600; cursor: pointer;">
              Upload your own photo to test it on the case
            </button>
          </div>

          <!-- Bottom Action -->
          <button type="button" data-open-drawer data-qty="2" class="kosnora-btn-primary" style="width: 100%; justify-content: center;">
            <span>GET YOUR KOSNORA CASE</span>
            <span style="font-size: 11px; font-weight: 600; color: #4B5563;">— From $59.90</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker Badge",
      "default": "KOSNORA Ink NFC Smart Phone Case"
    },
    {
      "type": "text",
      "id": "headline_1",
      "label": "Headline Line 1",
      "default": "YOUR PHONE."
    },
    {
      "type": "text",
      "id": "headline_2",
      "label": "Headline Line 2",
      "default": "YOUR PICTURE."
    },
    {
      "type": "text",
      "id": "headline_3",
      "label": "Headline Line 3",
      "default": "YOUR MOOD."
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Change the picture on the back of your phone whenever you want — in just 5 minutes."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "GET YOUR KOSNORA CASE"
    },
    {
      "type": "text",
      "id": "microcopy",
      "label": "Microcopy",
      "default": "Available for selected iPhone models"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
