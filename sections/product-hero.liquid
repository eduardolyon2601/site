<section id="product" class="section-dark" style="background: #000; padding: 2.5rem 0 4rem; color: #FFF; border-bottom: 1px solid #1E2026;">
  <div class="kosnora-container">
    <!-- Breadcrumb -->
    <div style="font-size: 11px; font-weight: 800; letter-spacing: 0.1em; color: #9CA3AF; text-transform: uppercase; margin-bottom: 2rem;">
      <span style="color: #C084FC;">HOME</span> / <span>SMART ACCESSORIES</span> / <span style="color: #FFF;">KOSNORA INK SMART CASE</span>
    </div>

    <!-- 2-Column Master Rooog Layout -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3.5rem; align-items: start;">
      <!-- Left: Product Gallery -->
      <div>
        <div style="position: relative; aspect-ratio: 4/3; border-radius: 16px; overflow: hidden; background: #0A0A0E; border: 1px solid #27272A; box-shadow: 0 20px 40px rgba(0,0,0,0.8); margin-bottom: 1rem;">
          <div style="position: absolute; top: 1rem; left: 1rem; z-index: 10; display: flex; gap: 0.5rem;">
            <span style="background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); border: 1px solid rgba(168,85,247,0.5); color: #C084FC; font-size: 10px; font-weight: 900; padding: 4px 10px; border-radius: 9999px; text-transform: uppercase; letter-spacing: 0.08em;">
              ⚡ BATTERY-FREE NFC DISPLAY
            </span>
          </div>
          <img id="main-product-img" src="{{ 'kosnora_hero_case.jpg' | asset_url }}" alt="KOSNORA Ink Smart Phone Case" style="width: 100%; height: 100%; object-fit: cover;">
        </div>

        <!-- Thumbnails -->
        <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.5rem; margin-bottom: 1rem;">
          <div style="aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; border: 2px solid #A855F7; cursor: pointer;">
            <img src="{{ 'kosnora_hero_case.jpg' | asset_url }}" alt="Studio" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div style="aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; border: 1px solid #27272A; cursor: pointer; opacity: 0.7;">
            <img src="{{ 'kosnora_couple_look.jpg' | asset_url }}" alt="Couple" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div style="aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; border: 1px solid #27272A; cursor: pointer; opacity: 0.7;">
            <img src="{{ 'kosnora_pet_look.jpg' | asset_url }}" alt="Pet" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div style="aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; border: 1px solid #27272A; cursor: pointer; opacity: 0.7;">
            <img src="{{ 'kosnora_travel_art.jpg' | asset_url }}" alt="Travel" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div style="aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; border: 1px solid #27272A; cursor: pointer; opacity: 0.7;">
            <img src="{{ 'kosnora_close_up.jpg' | asset_url }}" alt="Details" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
          <div style="aspect-ratio: 4/3; border-radius: 8px; overflow: hidden; border: 1px solid #27272A; cursor: pointer; opacity: 0.7;">
            <img src="{{ 'kosnora_unboxing.jpg' | asset_url }}" alt="Unboxing" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; text-align: center;">
          <div style="background: #0A0A0E; border: 1px solid #1E2026; padding: 0.75rem; border-radius: 10px;">
            <span style="color: #C084FC; font-weight: 900; font-size: 13px; display: block;">5 MIN</span>
            <span style="color: #9CA3AF; font-size: 10px; font-weight: 700; text-transform: uppercase;">Fast Refresh</span>
          </div>
          <div style="background: #0A0A0E; border: 1px solid #1E2026; padding: 0.75rem; border-radius: 10px;">
            <span style="color: #C084FC; font-weight: 900; font-size: 13px; display: block;">0% DRAIN</span>
            <span style="color: #9CA3AF; font-size: 10px; font-weight: 700; text-transform: uppercase;">Zero Battery</span>
          </div>
          <div style="background: #0A0A0E; border: 1px solid #1E2026; padding: 0.75rem; border-radius: 10px;">
            <span style="color: #C084FC; font-weight: 900; font-size: 13px; display: block;">MIL-SPEC</span>
            <span style="color: #9CA3AF; font-size: 10px; font-weight: 700; text-transform: uppercase;">Drop Defense</span>
          </div>
        </div>
      </div>

      <!-- Right: Buy Box -->
      <div>
        <!-- Rating & Title -->
        <div style="margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
            <span style="color: #C084FC; letter-spacing: 2px;">★★★★★</span>
            <span style="font-size: 12px; font-weight: 900; color: #E5E7EB;">4.9</span>
            <span style="color: #6B7280;">·</span>
            <span style="font-size: 12px; font-weight: 700; color: #9CA3AF; text-decoration: underline;">1,240+ Verified Reviews</span>
          </div>
          <h1 style="font-size: clamp(2rem, 3.5vw, 2.75rem); font-weight: 900; text-transform: uppercase; line-height: 1.1; margin: 0 0 0.5rem;">
            {{ product.title | default: 'KOSNORA Ink Smart Phone Case' }}
          </h1>
          <div style="font-size: 11px; font-weight: 900; letter-spacing: 0.1em; color: #C084FC; text-transform: uppercase;">
            DIY PICTURE SMART SCREEN · PASSIVE NFC TECHNOLOGY
          </div>
        </div>

        <!-- Pricing Box -->
        <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 14px; padding: 1.25rem; margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem;">
            <div>
              <span style="font-size: 2.25rem; font-weight: 900; color: #FFF;">$79.90</span>
              <span style="font-size: 12px; color: #9CA3AF; font-weight: 600; margin-left: 0.5rem;">($59.90 in Bundle)</span>
            </div>
            <span style="background: linear-gradient(135deg, #9333EA, #7E22CE); color: #FFF; font-size: 11px; font-weight: 900; padding: 3px 10px; border-radius: 9999px; text-transform: uppercase;">
              SAVE UP TO $60.00
            </span>
          </div>
          <p style="font-size: 12px; color: #9CA3AF; font-weight: 500; margin: 0;">
            Have the picture you want on your phone whenever you want — in just 5 minutes.
          </p>
        </div>

        <!-- Bundle Packages -->
        <div style="margin-bottom: 1.5rem;">
          <label style="display: block; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; color: #E5E7EB; margin-bottom: 0.75rem;">
            1. Select Package:
          </label>
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">
            <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 10px; padding: 0.875rem 1rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer;">
              <div>
                <span style="font-weight: 900; font-size: 13px; text-transform: uppercase;">1 Case</span>
                <span style="display: block; font-size: 11px; color: #9CA3AF;">1 KOSNORA Smart Phone Case</span>
              </div>
              <span style="font-weight: 900; font-size: 15px;">$79.90</span>
            </div>
            <div style="background: #150F22; border: 2px solid #A855F7; border-radius: 10px; padding: 0.875rem 1rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer; box-shadow: 0 0 15px rgba(168,85,247,0.2);">
              <div>
                <span style="font-weight: 900; font-size: 13px; text-transform: uppercase;">2 Cases</span>
                <span style="background: #A855F7; color: #FFF; font-size: 9px; font-weight: 900; padding: 2px 6px; border-radius: 4px; margin-left: 6px;">POPULAR · SAVE $20</span>
                <span style="display: block; font-size: 11px; color: #C084FC;">$69.90 each</span>
              </div>
              <div style="text-align: right;">
                <span style="font-weight: 900; font-size: 15px;">$139.80</span>
              </div>
            </div>
            <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 10px; padding: 0.875rem 1rem; display: flex; justify-content: space-between; align-items: center; cursor: pointer;">
              <div>
                <span style="font-weight: 900; font-size: 13px; text-transform: uppercase;">3 Cases</span>
                <span style="background: #6D28D9; color: #FFF; font-size: 9px; font-weight: 900; padding: 2px 6px; border-radius: 4px; margin-left: 6px;">BEST VALUE · SAVE $60</span>
                <span style="display: block; font-size: 11px; color: #C084FC;">$59.90 each</span>
              </div>
              <div style="text-align: right;">
                <span style="font-weight: 900; font-size: 15px;">$179.70</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Model Selection -->
        <div style="margin-bottom: 1.5rem;">
          <label style="display: block; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; color: #E5E7EB; margin-bottom: 0.5rem;">
            2. Select iPhone Model:
          </label>
          <select style="width: 100%; background: #0A0A0E; border: 1px solid #27272A; color: #FFF; font-weight: 700; font-size: 13px; padding: 0.875rem 1rem; border-radius: 10px; outline: none; cursor: pointer;">
            <option>iPhone 17 Pro Max</option>
            <option>iPhone 17 Pro</option>
            <option>iPhone 17</option>
            <option selected>iPhone 16 Pro Max</option>
            <option>iPhone 16 Pro</option>
            <option>iPhone 16</option>
            <option>iPhone 15 Pro Max</option>
            <option>iPhone 15 Pro</option>
            <option>iPhone 15</option>
            <option>iPhone 14 Pro Max</option>
            <option>iPhone 12 Pro Max</option>
          </select>
        </div>

        <!-- Color Swatches -->
        <div style="margin-bottom: 2rem;">
          <label style="display: block; font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em; color: #E5E7EB; margin-bottom: 0.5rem;">
            3. Choose Finish:
          </label>
          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem;">
            <div style="border: 2px solid #A855F7; background: #150F22; padding: 0.5rem; border-radius: 10px; text-align: center; cursor: pointer;">
              <span style="display: inline-block; width: 18px; height: 18px; border-radius: 50%; background: #161618; border: 1px solid #3F3F46;"></span>
              <span style="display: block; font-size: 10px; font-weight: 700; color: #E5E7EB; margin-top: 2px;">Obsidian</span>
            </div>
            <div style="border: 1px solid #27272A; background: #0A0A0E; padding: 0.5rem; border-radius: 10px; text-align: center; cursor: pointer;">
              <span style="display: inline-block; width: 18px; height: 18px; border-radius: 50%; background: #4A4C50; border: 1px solid #3F3F46;"></span>
              <span style="display: block; font-size: 10px; font-weight: 700; color: #9CA3AF; margin-top: 2px;">Titanium</span>
            </div>
            <div style="border: 1px solid #27272A; background: #0A0A0E; padding: 0.5rem; border-radius: 10px; text-align: center; cursor: pointer;">
              <span style="display: inline-block; width: 18px; height: 18px; border-radius: 50%; background: #EAEAEA; border: 1px solid #3F3F46;"></span>
              <span style="display: block; font-size: 10px; font-weight: 700; color: #9CA3AF; margin-top: 2px;">Cloud White</span>
            </div>
            <div style="border: 1px solid #27272A; background: #0A0A0E; padding: 0.5rem; border-radius: 10px; text-align: center; cursor: pointer;">
              <span style="display: inline-block; width: 18px; height: 18px; border-radius: 50%; background: #1C2433; border: 1px solid #3F3F46;"></span>
              <span style="display: block; font-size: 10px; font-weight: 700; color: #9CA3AF; margin-top: 2px;">Midnight</span>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem;">
          <button type="button" data-open-drawer data-qty="2" class="kosnora-btn-primary" style="background: linear-gradient(135deg, #9333EA 0%, #A855F7 50%, #7E22CE 100%); padding: 1.15rem; font-size: 0.875rem; border-radius: 12px; box-shadow: 0 0 25px rgba(168,85,247,0.45); border: none; color: #FFF; font-weight: 900; text-transform: uppercase; cursor: pointer;">
            ADD TO CART · $139.80
          </button>
          <button type="button" data-open-drawer data-qty="2" class="kosnora-btn-secondary" style="background: #FFF; color: #000; padding: 1rem; font-size: 0.8125rem; border-radius: 12px; border: none; font-weight: 900; text-transform: uppercase; cursor: pointer;">
            BUY NOW (INSTANT CHECKOUT)
          </button>
        </div>

        <!-- Trust Features -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; font-size: 11px; font-weight: 700; color: #D4D4D8;">
          <div style="background: #0A0A0E; border: 1px solid #1E2026; padding: 0.65rem 0.75rem; border-radius: 8px;">
            🚚 Fast 3–7 Day US Delivery
          </div>
          <div style="background: #0A0A0E; border: 1px solid #1E2026; padding: 0.65rem 0.75rem; border-radius: 8px;">
            🛡️ 30-Day Fit Guarantee
          </div>
          <div style="background: #0A0A0E; border: 1px solid #1E2026; padding: 0.65rem 0.75rem; border-radius: 8px;">
            ⚡ 100% Battery-Free
          </div>
          <div style="background: #0A0A0E; border: 1px solid #1E2026; padding: 0.65rem 0.75rem; border-radius: 8px;">
            🔒 Secure 256-Bit Checkout
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

