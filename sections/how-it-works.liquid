<section id="how-it-works" class="section-dark" style="background: #050508; padding: 4.5rem 0; border-bottom: 1px solid #1E2026; color: #FFF;">
  <div class="kosnora-container">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 3rem;">
      <span style="font-size: 11px; font-weight: 900; letter-spacing: 0.15em; text-transform: uppercase; color: #C084FC; display: block; margin-bottom: 0.5rem;">
        3 Simple Steps
      </span>
      <h2 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; text-transform: uppercase; letter-spacing: -0.02em; margin: 0;">
        {{ section.settings.headline | default: 'HOW IT WORKS' }}
      </h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 3rem;">
      <!-- Step 01 -->
      <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span style="font-size: 1.75rem; font-weight: 900; color: #C084FC;">01</span>
            <span style="font-size: 11px; font-weight: 800; color: #A1A1AA; text-transform: uppercase; letter-spacing: 0.05em;">Step 1</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.5rem;">CHOOSE</h3>
          <p style="font-size: 0.875rem; color: #A1A1AA; font-weight: 600; margin-bottom: 1.25rem;">Choose the image you want.</p>
        </div>
        <div style="aspect-ratio: 4/3; border-radius: 12px; overflow: hidden; background: #121318;">
          <img src="{{ 'kosnora_couple_look.jpg' | asset_url }}" alt="Choose image" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
      </div>

      <!-- Step 02 -->
      <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span style="font-size: 1.75rem; font-weight: 900; color: #C084FC;">02</span>
            <span style="font-size: 11px; font-weight: 800; color: #A1A1AA; text-transform: uppercase; letter-spacing: 0.05em;">Step 2</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.5rem;">SET</h3>
          <p style="font-size: 0.875rem; color: #A1A1AA; font-weight: 600; margin-bottom: 1.25rem;">Set up your KOSNORA case.</p>
        </div>
        <div style="aspect-ratio: 4/3; border-radius: 12px; overflow: hidden; background: #121318;">
          <img src="{{ 'kosnora_pet_look.jpg' | asset_url }}" alt="Set up case" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
      </div>

      <!-- Step 03 -->
      <div style="background: #0A0A0E; border: 1px solid #27272A; border-radius: 16px; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span style="font-size: 1.75rem; font-weight: 900; color: #C084FC;">03</span>
            <span style="font-size: 11px; font-weight: 800; color: #A1A1AA; text-transform: uppercase; letter-spacing: 0.05em;">Step 3</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 900; text-transform: uppercase; margin-bottom: 0.5rem;">CHANGE</h3>
          <p style="font-size: 0.875rem; color: #A1A1AA; font-weight: 600; margin-bottom: 1.25rem;">Change your look whenever you want.</p>
        </div>
        <div style="aspect-ratio: 4/3; border-radius: 12px; overflow: hidden; background: #121318;">
          <img src="{{ 'kosnora_hero_case.jpg' | asset_url }}" alt="Change look anytime" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
      </div>
    </div>

    <div style="text-align: center;">
      <button type="button" data-open-drawer data-qty="2" class="kosnora-btn-primary" style="background: linear-gradient(135deg, #9333EA 0%, #A855F7 50%, #7E22CE 100%); box-shadow: 0 0 20px rgba(168, 85, 247, 0.4); padding: 1rem 2.25rem; font-size: 0.8125rem;">
        <span>{{ section.settings.cta_text | default: 'CREATE MY LOOK' }}</span>
        {% render 'icon-arrow-right' %}
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "HOW IT WORKS"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "CREATE MY LOOK"
    }
  ],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}
