<section id="benefits" class="section-light kosnora-py" style="border-top: 1px solid #E5E7EB;">
  <div class="kosnora-container">
    <!-- Header -->
    <div style="max-width: 760px; margin: 0 auto; text-align: center; margin-bottom: 4rem;">
      <span class="kosnora-kicker-badge light">
        {{ section.settings.kicker | default: 'Crafted For Expression' }}
      </span>
      <h2 class="kosnora-headline" style="font-size: clamp(2rem, 4.5vw, 3.5rem); color: #111827; margin-bottom: 1.25rem;">
        {{ section.settings.headline | default: 'Engineered To Be Truly Yours' }}
      </h2>
      <p class="kosnora-subtitle" style="font-size: 1.125rem; color: #4B5563;">
        {{ section.settings.description | default: 'Every detail of KOSNORA is built to elevate your smartphone experience without adding friction or complication.' }}
      </p>
    </div>

    <!-- 6 Benefits Cards Grid -->
    <div class="kosnora-grid-3" style="margin-bottom: 4rem;">
      <!-- Benefit 1 -->
      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: #111827; margin-bottom: 0.5rem;">
          PERSONALIZE YOUR PHONE
        </h3>
        <p style="font-weight: 600; color: #1F2937; font-size: 0.875rem; margin-bottom: 0.5rem;">
          Make your phone look like yours.
        </p>
        <p style="font-size: 0.8125rem; color: #6B7280; line-height: 1.5;">
          Break free from anonymous hardware. Express what inspires you directly on your everyday device.
        </p>
      </div>

      <!-- Benefit 2 -->
      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: #111827; margin-bottom: 0.5rem;">
          CHANGE YOUR STYLE
        </h3>
        <p style="font-weight: 600; color: #1F2937; font-size: 0.875rem; margin-bottom: 0.5rem;">
          Switch between photos, designs and moods whenever you want.
        </p>
        <p style="font-size: 0.8125rem; color: #6B7280; line-height: 1.5;">
          From formal meetings to weekend festivals, update the artwork to match the occasion in minutes.
        </p>
      </div>

      <!-- Benefit 3 -->
      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: #111827; margin-bottom: 0.5rem;">
          NO BATTERY REQUIRED
        </h3>
        <p style="font-weight: 600; color: #1F2937; font-size: 0.875rem; margin-bottom: 0.5rem;">
          Enjoy the smart display concept without charging another device.
        </p>
        <p style="font-size: 0.8125rem; color: #6B7280; line-height: 1.5;">
          Zero battery degradation, zero cables. Your phone screen updates effortlessly via passive NFC.
        </p>
      </div>

      <!-- Benefit 4 -->
      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: #111827; margin-bottom: 0.5rem;">
          STAND OUT
        </h3>
        <p style="font-weight: 600; color: #1F2937; font-size: 0.875rem; margin-bottom: 0.5rem;">
          A phone case designed to get attention.
        </p>
        <p style="font-size: 0.8125rem; color: #6B7280; line-height: 1.5;">
          An eye-catching statement piece that turns heads and sparks genuine conversation wherever you place it.
        </p>
      </div>

      <!-- Benefit 5 -->
      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: #111827; margin-bottom: 0.5rem;">
          PERFECT FOR YOUR FAVORITE MEMORIES
        </h3>
        <p style="font-weight: 600; color: #1F2937; font-size: 0.875rem; margin-bottom: 0.5rem;">
          Display photos of your favorite people, pets, places and moments.
        </p>
        <p style="font-size: 0.8125rem; color: #6B7280; line-height: 1.5;">
          Keep your partner, your pet, or an unforgettable travel horizon right in front of you all day.
        </p>
      </div>

      <!-- Benefit 6 -->
      <div class="kosnora-card-light">
        <h3 class="kosnora-title" style="font-size: 1rem; text-transform: uppercase; letter-spacing: 0.05em; color: #111827; margin-bottom: 0.5rem;">
          YOUR STYLE, YOUR WAY
        </h3>
        <p style="font-weight: 600; color: #1F2937; font-size: 0.875rem; margin-bottom: 0.5rem;">
          Match your phone to your personality.
        </p>
        <p style="font-size: 0.8125rem; color: #6B7280; line-height: 1.5;">
          Minimalist architecture, vibrant graphic art, or sentimental candid memories — you control the vibe.
        </p>
      </div>
    </div>

    <!-- Transformation Visual Banner -->
    <div style="max-width: 900px; margin: 0 auto; background: #0A0A0C; border-radius: 1.75rem; padding: 3.5rem 2rem; text-align: center; color: #FFF; box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);">
      <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.2em; color: #9CA3AF; display: block; margin-bottom: 1.5rem;">
        The Evolution
      </span>
      <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1rem; font-size: clamp(1.5rem, 4vw, 2.5rem); font-weight: 800; margin-bottom: 1.5rem;">
        <span style="color: #9CA3AF;">ONE PHONE CASE</span>
        <span style="color: #FFF;">→</span>
        <span style="color: #FFF; text-decoration: underline; text-underline-offset: 8px;">COUNTLESS LOOKS</span>
      </div>
      <p style="font-size: 1rem; color: #D1D5DB; max-width: 580px; margin: 0 auto 2rem; line-height: 1.6;">
        Never buy another static case just to change your phone aesthetic. Keep one durable, protective smart case and evolve your look forever.
      </p>
      <div>
        <button type="button" data-open-drawer data-qty="2" class="kosnora-btn-primary">
          <span>{{ section.settings.cta_text | default: 'MAKE MY PHONE UNIQUE' }}</span>
          {% render 'icon-arrow-right' %}
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits Section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Crafted For Expression"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Engineered To Be Truly Yours"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every detail of KOSNORA is built to elevate your smartphone experience without adding friction or complication."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "MAKE MY PHONE UNIQUE"
    }
  ],
  "presets": [
    {
      "name": "Benefits Section"
    }
  ]
}
{% endschema %}
